# Reference for Cloudflare Settings > Builds > Build variables and secrets.
# Enter each value in the dashboard. This example file is not loaded by Next.js.
NEXT_PUBLIC_WEB_URL=https://aidesignkitchen.com
NEXT_PUBLIC_PROJECT_NAME="AI Kitchen Design"
NEXT_PUBLIC_AUTH_ENABLED=true
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=true
# Required by the kitchen designer even with One Tap turned off.
# Set to the same Google OAuth Web client ID as AUTH_GOOGLE_ID.
NEXT_PUBLIC_AUTH_GOOGLE_ID=
NEXT_PUBLIC_AUTH_GOOGLE_ONE_TAP_ENABLED=false
NEXT_PUBLIC_AUTH_GITHUB_ENABLED=false
NEXT_PUBLIC_LOCALE_DETECTION=false
NEXT_PUBLIC_DEFAULT_THEME=light
NEXT_PUBLIC_PAY_SUCCESS_URL=/my-orders
NEXT_PUBLIC_PAY_FAIL_URL=/pricing
NEXT_PUBLIC_PAY_CANCEL_URL=/pricing
